    {
      "speaker": "B",
      "text": "Qual \u00e8 l'obiettivo del progetto?",
      "translation": "What is the goal of the project?"
    },
    {
      "speaker": "A",
      "text": "L'obiettivo \u00e8 migliorare la soddisfazione del cliente.",
      "translation": "The goal is to improve customer satisfaction."
    },
    {
      "speaker": "B",
      "text": "Qual \u00e8 il programma?",
      "translation": "What is the schedule?"
    },
    {
      "speaker": "A",
      "text": "Vogliamo terminarlo in tre mesi.",
      "translation": "We want to have it ready in three months."
    },
    {
      "speaker": "B",
      "text": "\u00c8 un programma stretto.",
      "translation": "That is a tight schedule."
    },
    {
      "speaker": "A",
      "text": "Abbiamo bisogno di pi\u00f9 risorse.",
      "translation": "We need more resources."
    },
    {
      "speaker": "B",
      "text": "Possiamo usare il bilancio del prossimo trimestre.",
      "translation": "We can use the budget from next quarter."
