      "text": "Riavvialo prima.",
      "translation": "Restart it first."
    },
    {
      "speaker": "A",
      "text": "Non ha aiutato.",
      "translation": "That didn't help."
    },
    {
      "speaker": "B",
      "text": "Controlla lo spazio disco.",
      "translation": "Check the disk space."
    },
    {
      "speaker": "A",
      "text": "Il disco \u00e8 pieno.",
      "translation": "The disk is full."
    },
    {
      "speaker": "B",
      "text": "Elimina i file inutili.",
      "translation": "Delete unnecessary files."
    },
    {
      "speaker": "A",
      "text": "Posso usare un disco esterno?",
      "translation": "Can I use an external drive?"
