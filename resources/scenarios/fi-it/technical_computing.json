  "dialogues": [
    {
      "speaker": "A",
      "text": "Ciao, il mio computer si \u00e8 rallentato.",
      "translation": "Hi, my computer has slowed down."
    },
    {
      "speaker": "B",
      "text": "Contatta il supporto IT.",
