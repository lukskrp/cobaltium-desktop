  "phrases": [
    {
      "phrase": "\u4f1a\u8b70\u3092\u59cb\u3081\u307e\u3057\u3087\u3046\u304b\uff1f",
      "translation": "Shall we start the meeting?",
      "context": "Starting a meeting"
    },
    {
      "phrase": "\u3054\u610f\u898b\u306f\u3069\u3046\u3067\u3059\u304b\uff1f",
      "translation": "What do you think?",
      "context": "Asking for opinions"
    },
    {
      "phrase": "...\u3059\u308b\u3053\u3068\u3092\u63d0\u6848\u3057\u307e\u3059\u3002",
      "translation": "I suggest that...",
      "context": "Making a suggestion"
    },
    {
      "phrase": "\u540c\u610f\u3057\u307e\u3059\u3002",
      "translation": "We agree.",
      "context": "Expressing agreement"
    },
    {
      "phrase": "\u3088\u308a\u591a\u304f\u306e\u6642\u9593\u304c\u5fc5\u8981\u3067\u3059\u3002",
      "translation": "We need more time.",
      "context": "Requesting time"
    },
    {
      "phrase": "\u8cea\u554f\u306f\u91cd\u8981\u3067\u3059\u3002",
      "translation": "The question is important.",
      "context": "Emphasizing importance"
    },
    {
      "phrase": "\u4eca\u6c7a\u5b9a\u3067\u304d\u307e\u3059\u304b\uff1f",
      "translation": "Can we decide now?",
      "context": "Pushing for decision"
    },
    {
      "phrase": "\u7686\u3055\u3093\u3001\u3042\u308a\u304c\u3068\u3046\u3002",
      "translation": "Thank you everyone.",
      "context": "Ending a meeting"
    },
    {
      "phrase": "\u6b21\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7d39\u4ecb\u3057\u307e\u3059\u3002",
      "translation": "I will present the next point.",
      "context": "Moving to next topic"
    },
    {
      "phrase": "\u8cea\u554f\u306f\u3042\u308a\u307e\u3059\u304b\uff1f",
      "translation": "Are there any questions?",
      "context": "Opening for questions"
    },
    {
      "phrase": "\u5f8c\u3067\u3082\u3046\u4e00\u5ea6\u3053\u306e\u4ef6\u306b\u623b\u308a\u307e\u3057\u3087\u3046\u3002",
      "translation": "Let us return to this later.",
      "context": "Deferring discussion"
    },
    {
      "phrase": "\u3053\u308c\u306b\u3088\u308a\u8a73\u7d30\u306a\u8abf\u67fb\u304c\u5fc5\u8981\u3067\u3059\u3002",
      "translation": "This requires closer examination.",
      "context": "Requesting more analysis"
    },
    {
      "phrase": "\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u901a\u308a\u306b\u9032\u3093\u3067\u3044\u307e\u3059\u3002",
      "translation": "We are on schedule.",
      "context": "Status update"
    },
    {
      "phrase": "\u4f5c\u696d\u30c1\u30fc\u30e0\u304c\u3053\u308c\u3092\u7d9a\u3051\u307e\u3059\u3002",
      "translation": "The working group will continue this.",
      "context": "Delegating task"
    },
    {
      "phrase": "\u6b21\u306e\u4f1a\u8b70\u306f\u6765\u9031\u3067\u3059\u3002",
      "translation": "The next meeting is next week.",
      "context": "Scheduling follow-up"
    },
    {
      "phrase": "\u826f\u3044\u8b70\u8ad6\u3092\u3042\u308a\u304c\u3068\u3046\u3002",
      "translation": "Thank you for the good discussion.",
      "context": "Closing remark"
    }
  ],
  "dialogues": [
    {
      "speaker": "A",
      "text": "\u7686\u3055\u3093\u3001\u304a\u306f\u3088\u3046\u3054\u3056\u3044\u307e\u3059\u3002\u59cb\u3081\u307e\u3057\u3087\u3046\u304b\uff1f",
      "translation": "Good morning everyone. Shall we start?"
    },
    {
      "speaker": "B",
      "text": "\u306f\u3044\u3001\u6e96\u5099\u597d\u4e86\u3067\u3059\u3002",
      "translation": "Yes, we are ready."
    },
    {
      "speaker": "A",
      "text": "\u4eca\u65e5\u65b0\u3057\u3044\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306b\u3064\u3044\u3066\u8b70\u8ad6\u3057\u307e\u3059\u3002",
      "translation": "Today we will discuss the new project."
    },
    {
      "speaker": "B",
      "text": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u76ee\u6a19\u306f\u4f55\u3067\u3059\u304b\uff1f",
      "translation": "What is the goal of the project?"
    },
    {
      "speaker": "A",
      "text": "\u76ee\u6a19\u306f\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u3067\u3059\u3002",
      "translation": "The goal is to improve customer satisfaction."
    },
    {
      "speaker": "B",
      "text": "\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u306f\u3069\u3046\u306a\u3063\u3066\u3044\u307e\u3059\u304b\uff1f",
      "translation": "What is the schedule?"
    },
    {
      "speaker": "A",
      "text": "3\u30f6\u6708\u3067\u5b8c\u6210\u3055\u305b\u305f\u3044\u3067\u3059\u3002",
      "translation": "We want to have it ready in three months."
    },
    {
      "speaker": "B",
      "text": "\u305d\u308c\u306f\u30bf\u30a4\u30c8\u306a\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3067\u3059\u3002",
      "translation": "That is a tight schedule."
    },
    {
      "speaker": "A",
      "text": "\u3088\u308a\u591a\u304f\u306e\u30ea\u30bd\u30fc\u30b9\u304c\u5fc5\u8981\u3067\u3059\u3002",
      "translation": "We need more resources."
    },
    {
      "speaker": "B",
      "text": "\u6b21\u306e\u56db\u534a\u671f\u306e\u4e88\u7b97\u3092\u4f7f\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002",
      "translation": "We can use the budget from next quarter."
    },
    {
      "speaker": "A",
      "text": "\u826f\u3044\u30a2\u30a4\u30c7\u30a2\u3067\u3059\u3002\u8ab0\u304c\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u8cac\u4efb\u8005\u3067\u3059\u304b\uff1f",
      "translation": "Good idea. Who is responsible for the project?"
    },
    {
      "speaker": "B",
      "text": "\u79c1\u304c\u8cac\u4efb\u3092\u53d6\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002",
      "translation": "I can take responsibility."
    },
    {
      "speaker": "A",
      "text": "\u7d20\u6674\u3089\u3057\u3044\u3002\u6b21\u306e\u4f1a\u8b70\u306f\u6765\u9031\u306b\u3057\u307e\u3057\u3087\u3046\u3002",
      "translation": "Excellent. Let us hold the next meeting next week."
    },
    {
      "speaker": "B",
      "text": "\u4e86\u89e3\u3067\u3059\u3002\u7686\u3055\u3093\u3042\u308a\u304c\u3068\u3046\u3002",
      "translation": "Agreed. Thank you everyone."
    },
    {
      "speaker": "A",
      "text": "\u7686\u3055\u3093\u3001\u826f\u3044\u4e00\u65e5\u3092\u3002",
      "translation": "Have a good day everyone."
    },
    {
      "speaker": "B",
      "text": "\u3042\u308a\u304c\u3068\u3046\u3001\u3042\u306a\u305f\u3082\u3002",
      "translation": "Thank you, you too."
    }
  ]
}