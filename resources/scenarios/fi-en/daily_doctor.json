  "dialogues": [
    {
      "speaker": "A",
      "text": "Hyv\u00e4\u00e4 huomenta! Mit\u00e4 h\u00e4t\u00e4n\u00e4?",
      "translation": "Good morning! What is the problem?"
    },
    {
      "speaker": "B",
      "text": "Minulla on p\u00e4\u00e4ns\u00e4rky\u00e4 jo p\u00e4iv\u00e4.",
      "translation": "I have had a headache for a day."
    },
    {
      "speaker": "A",
      "text": "Miss\u00e4 sattuu?",
      "translation": "Where does it hurt?"
    },
    {
      "speaker": "B",
      "text": "Otsalla ja takaraivossa.",
      "translation": "On the forehead and back of the head."
    },
    {
      "speaker": "A",
      "text": "Onko muita oireita?",
      "translation": "Are there other symptoms?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, minulla on my\u00f6s kuume.",
      "translation": "Yes, I also have a fever."
    },
    {
      "speaker": "A",
      "text": "Mitattakohan l\u00e4mp\u00f6.",
      "translation": "Let us measure the temperature."
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, kiitos.",
      "translation": "Yes, thank you."
    },
    {
      "speaker": "A",
      "text": "L\u00e4mp\u00f6 on 38,5 astetta. Sinulla on flunssa.",
      "translation": "The temperature is 38.5 degrees. You have the flu."
    },
    {
      "speaker": "B",
      "text": "Mit\u00e4 pit\u00e4isi tehd\u00e4?",
      "translation": "What should I do?"
    },
    {
      "speaker": "A",
      "text": "Levit\u00e4 kotona ja juo paljon vett\u00e4.",
      "translation": "Rest at home and drink plenty of water."
    },
    {
      "speaker": "B",
      "text": "Tarvitsenko l\u00e4\u00e4kett\u00e4?",
      "translation": "Do I need medicine?"
    },
    {
      "speaker": "A",
      "text": "Kyll\u00e4, annan reseptin.",
      "translation": "Yes, I will give you a prescription."
    },
    {
      "speaker": "B",
      "text": "Kiitos, l\u00e4\u00e4k\u00e4ri.",
      "translation": "Thank you, doctor."
    },
    {
      "speaker": "A",
      "text": "Tule takaisin, jos ei paranee.",
      "translation": "Come back if it doesn't get better."
    },
    {
      "speaker": "B",
      "text": "Kiitos huolenpidosta!",
      "translation": "Thank you for your care!"
