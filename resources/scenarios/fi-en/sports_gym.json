  "dialogues": [
    {
      "speaker": "A",
      "text": "Hei! Oletko uusi t\u00e4\u00e4ll\u00e4?",
      "translation": "Hi! Are you new here?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, t\u00e4n\u00e4\u00e4n on ensimm\u00e4inen p\u00e4iv\u00e4ni.",
      "translation": "Yes, today is my first day."
