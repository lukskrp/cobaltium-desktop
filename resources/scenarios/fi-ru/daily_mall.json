  "dialogues": [
    {
      "speaker": "A",
      "text": "Tervetuloa kauppaan!",
      "translation": "Welcome to the store!"
    },
    {
      "speaker": "B",
      "text": "Kiitos. Etsin uutta paitaa.",
      "translation": "Thank you. I'm looking for a new shirt."
    },
    {
      "speaker": "A",
      "text": "Millaista etsit?",
      "translation": "What kind are you looking for?"
    },
    {
      "speaker": "B",
      "text": "Sinist\u00e4, kokoa M.",
      "translation": "Blue, size M."
    },
    {
      "speaker": "A",
      "text": "\u0412\u043e\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432.",
      "translation": "Here are a few options."
    },
    {
      "speaker": "B",
      "text": "Hienoa! Mik\u00e4 on hinta?",
      "translation": "Great! What is the price?"
    },
    {
      "speaker": "A",
      "text": "Hinta on kolmekymment\u00e4 euroa.",
      "translation": "The price is thirty euros."
    },
    {
      "speaker": "B",
      "text": "Onko alennusta?",
      "translation": "Is there a discount?"
    },
    {
      "speaker": "A",
      "text": "Kyll\u00e4, t\u00e4n\u00e4\u00e4n on kymmenen prosentin alennus.",
      "translation": "Yes, today there is a ten percent discount."
    },
    {
      "speaker": "B",
      "text": "Upeaa! Otan t\u00e4m\u00e4n.",
      "translation": "Wonderful! I'll take this."
    },
    {
      "speaker": "A",
      "text": "Haluatko kassin?",
      "translation": "Do you want a bag?"
    },
    {
      "speaker": "B",
      "text": "Ei kiitos, omat pussit riitt\u00e4v\u00e4t.",
      "translation": "No thanks, my own bags are enough."
    },
    {
      "speaker": "A",
      "text": "Hyv\u00e4! Kiitos ostoksestasi.",
      "translation": "Good! Thank you for your purchase."
    },
    {
      "speaker": "B",
      "text": "Kiitos! Hyv\u00e4\u00e4 p\u00e4iv\u00e4njatkoa.",
      "translation": "Thank you! Have a good day."
    },
    {
      "speaker": "A",
      "text": "Sinullekin! Tervetuloa uudelleen.",
      "translation": "You too! Welcome back."
    },
    {
      "speaker": "B",
      "text": "Kiitos, tulen varmasti.",
      "translation": "Thank you, I will definitely come."
    }
  ]
