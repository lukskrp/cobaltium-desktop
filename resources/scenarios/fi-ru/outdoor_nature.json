  "dialogues": [
    {
      "speaker": "A",
      "text": "Hienoa s\u00e4\u00e4 t\u00e4n\u00e4\u00e4n!",
      "translation": "Great weather today!"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4! Haluatko menn\u00e4 retkelle?",
      "translation": "Yes! Do you want to go hiking?"
    },
    {
      "speaker": "A",
      "text": "Kyll\u00e4! Miss\u00e4 polku on?",
      "translation": "Yes! Where is the trail?"
    },
    {
      "speaker": "B",
      "text": "Se alkaa tuolta mets\u00e4n reunasta.",
      "translation": "It starts from the edge of the forest there."
    },
    {
      "speaker": "A",
      "text": "Hienoa! Otan teltan mukaan.",
      "translation": "Great! I will bring the tent."
    },
    {
      "speaker": "B",
      "text": "Hyv\u00e4 idea. Meill\u00e4 on my\u00f6s nuotiokalusteet.",
      "translation": "Good idea. We also have campfire equipment."
    },
    {
      "speaker": "A",
      "text": "Voimmeko kalastaa j\u00e4rvell\u00e4?",
      "translation": "Can we fish at the lake?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, tarvitset luvan.",
      "translation": "Yes, you need a permit."
    },
    {
      "speaker": "A",
      "text": "Miss\u00e4 saan luvan?",
      "translation": "Where can I get a permit?"
    },
    {
      "speaker": "B",
      "text": "Paikallisesta kaupasta.",
      "translation": "From the local store."
    },
    {
      "speaker": "A",
      "text": "Onko t\u00e4\u00e4ll\u00e4 marjoja?",
      "translation": "Are there berries here?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, mustikoita kasvaa paljon.",
      "translation": "Yes, there are many blueberries."
    },
    {
      "speaker": "A",
      "text": "Hienoa! Otan koria mukaan.",
      "translation": "Great! I will bring a basket."
    },
    {
      "speaker": "B",
      "text": "Muista juoda vett\u00e4.",
      "translation": "Remember to drink water."
    },
    {
      "speaker": "A",
      "text": "Kiitos vinkist\u00e4! T\u00e4m\u00e4 on hienoa.",
      "translation": "Thank you for the tip! This is great."
    },
    {
      "speaker": "B",
      "text": "Olemme l\u00e4hes leiripaikalla.",
      "translation": "We are almost at the campsite."
    }
  ]
