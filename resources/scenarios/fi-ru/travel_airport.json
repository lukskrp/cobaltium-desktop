      "context": "Finding food"
    },
    {
      "phrase": "\u041c\u043e\u0439 \u0447\u0435\u043c\u043e\u0434\u0430\u043d \u043f\u0440\u043e\u043f\u0430\u043b.",
      "translation": "My suitcase is lost.",
      "context": "Lost luggage"
    },
    {
      "phrase": "\u041c\u043d\u0435 \u043d\u0443\u0436\u0435\u043d \u0442\u0430\u043a\u0441\u0438.",
      "translation": "I need a taxi.",
      "context": "Getting transportation"
    },
    {
      "phrase": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043e\u043b\u0433\u043e?",
      "translation": "How long does it take?",
      "context": "Asking about duration"
    },
    {
      "phrase": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u043f\u043e\u043c\u043e\u0449\u044c.",
      "translation": "Thank you for your help.",
      "context": "Expressing gratitude"
    }
  ],
  "dialogues": [
    {
      "speaker": "A",
      "text": "\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u043d\u0430 \u0430\u044d\u0440\u043e\u043f\u043e\u0440\u0442!",
      "translation": "Welcome to the airport!"
    },
    {
      "speaker": "B",
      "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e. \u0413\u0434\u0435 \u0441\u0442\u043e\u0439\u043a\u0430?",
      "translation": "Thank you. Where is the counter?"
    },
    {
      "speaker": "A",
      "text": "\u0421\u0442\u043e\u0439\u043a\u0430 \u0432\u043e\u0442 \u0442\u0430\u043c, \u0441\u043f\u0440\u0430\u0432\u0430.",
      "translation": "The counter is over there on the right."
    },
    {
      "speaker": "B",
      "text": "\u041a \u043a\u0430\u043a\u043e\u043c\u0443 \u0432\u044b\u0445\u043e\u0434\u0443 \u043c\u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0438\u0434\u0442\u0438?",
      "translation": "Which gate do I need to go to?"
    },
    {
      "speaker": "A",
      "text": "\u0412\u044b\u0445\u043e\u0434 \u0432\u043e\u0441\u0435\u043c\u044c, \u043d\u0430 \u0432\u0442\u043e\u0440\u043e\u043c \u044d\u0442\u0430\u0436\u0435.",
      "translation": "Gate eight, on the second floor."
    },
    {
      "speaker": "B",
      "text": "\u0421\u043f\u0430\u0441\u0438\u0431\u043e. \u041a\u043e\u0433\u0434\u0430 \u0432\u0430\u0448 \u0440\u0435\u0439\u0441?",
      "translation": "Thank you. When does your flight leave?"
    },
    {
      "speaker": "A",
      "text": "\u0420\u0435\u0439\u0441 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u0432\u043e\u0441\u0435\u043c\u044c \u0447\u0430\u0441\u043e\u0432.",
      "translation": "The flight leaves at eight o'clock."
    },
    {
      "speaker": "B",
      "text": "\u0415\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0430?",
      "translation": "Is there a layover?"
    },
    {
      "speaker": "A",
      "text": "\u0414\u0430, \u0447\u0435\u0442\u044b\u0440\u0435\u0447\u0430\u0441\u043e\u0432\u0430\u044f \u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0430 \u0432 \u0421\u0442\u043e\u043a\u0433\u043e\u043b\u044c\u043c\u0435.",
      "translation": "Yes, a four-hour layover in Stockholm."
    },
    {
      "speaker": "B",
      "text": "\u042d\u0442\u043e \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0440\u0435\u0441\u0430\u0434\u043a\u0430.",
      "translation": "That is a long layover."
    },
    {
      "speaker": "A",
      "text": "\u041c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0437\u043e\u043d\u0443 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f?",
      "translation": "Can we use the waiting hall?"
    },
    {
      "speaker": "B",
      "text": "\u0414\u0430, \u0442\u0430\u043c \u0442\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u043a\u0430\u0444\u0435.",
      "translation": "Yes, there is also a caf\u00e9 there."
    },
    {
      "speaker": "A",
      "text": "\u041e\u0442\u043b\u0438\u0447\u043d\u043e! \u0427\u0442\u043e \u043f\u043e\u0441\u043e\u0432\u0435\u0442\u0443\u0435\u0442\u0435?",
      "translation": "Great! What do you recommend?"
    },
    {
      "speaker": "B",
      "text": "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0444\u0438\u043d\u0441\u043a\u0443\u044e \u0440\u044b\u0431\u043d\u0443\u044e \u0443\u0445\u0443.",
      "translation": "Try the Finnish fish soup."
    },
    {
      "speaker": "A",
      "text": "\u0417\u0432\u0443\u0447\u0438\u0442 \u0432\u043a\u0443\u0441\u043d\u043e!",
      "translation": "Sounds delicious!"
    },
    {
      "speaker": "B",
      "text": "\u0425\u043e\u0440\u043e\u0448\u0435\u0433\u043e \u043f\u0443\u0442\u0438!",
      "translation": "Have a good trip!"
    }
  ]
}