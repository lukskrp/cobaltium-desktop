    },
    {
      "phrase": "\u041c\u043e\u0436\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443?",
      "translation": "Can I talk on the phone?",
      "context": "Phone etiquette"
    },
    {
      "phrase": "\u0412\u0430\u0448 \u0440\u0435\u0439\u0441 \u043f\u043e \u0433\u0440\u0430\u0444\u0438\u043a\u0443?",
