      "context": "Asking about delays"
    },
    {
      "phrase": "\u041c\u043d\u0435 \u043d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c \u0441 \u0447\u0435\u043c\u043e\u0434\u0430\u043d\u043e\u043c.",
      "translation": "I need help with my suitcase.",
      "context": "Requesting assistance"
    },
    {
      "phrase": "\u0427\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c \u0432 \u0441\u0430\u043c\u043e\u043b\u0451\u0442?",
      "translation": "What can I bring on the plane?",
      "context": "Luggage rules"
    },
    {
      "phrase": "\u042f \u043d\u0435 \u043c\u043e\u0433\u0443 \u043d\u0430\u0439\u0442\u0438 \u043f\u0430\u0441\u043f\u043e\u0440\u0442.",
      "translation": "I cannot find my passport.",
      "context": "Lost items"
    },
    {
      "phrase": "\u0413\u0434\u0435 \u043f\u0440\u0438\u0451\u043c?",
      "translation": "Where is arrivals?",
      "context": "Finding arrivals"
    },
    {
      "phrase": "\u042f \u0445\u043e\u0442\u0435\u043b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0440\u0435\u0439\u0441.",
      "translation": "I would like to change my flight.",
      "context": "Changing flights"
    },
    {
      "phrase": "\u0417\u0434\u0435\u0441\u044c \u0435\u0441\u0442\u044c?",
