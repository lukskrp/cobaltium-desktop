  "dialogues": [
    {
      "speaker": "A",
      "text": "Tervetuloa lentoasemalle!",
      "translation": "Welcome to the airport!"
    },
    {
      "speaker": "B",
      "text": "Kiitos. Miss\u00e4 on tiski?",
      "translation": "Thank you. Where is the counter?"
    },
    {
      "speaker": "A",
      "text": "Tiski on tuolla oikealla.",
      "translation": "The counter is over there on the right."
    },
    {
      "speaker": "B",
      "text": "Mihin porttiin minun pit\u00e4\u00e4 menn\u00e4?",
      "translation": "Which gate do I need to go to?"
    },
    {
      "speaker": "A",
      "text": "Portti kahdeksan, toisessa kerroksessa.",
      "translation": "Gate eight, on the second floor."
    },
    {
      "speaker": "B",
      "text": "Kiitos. Milloin lentosi l\u00e4htee?",
      "translation": "Thank you. When does your flight leave?"
    },
    {
      "speaker": "A",
      "text": "Lento l\u00e4htee kello kahdeksan.",
      "translation": "The flight leaves at eight o'clock."
    },
    {
      "speaker": "B",
      "text": "Onko siin\u00e4 v\u00e4lilaskua?",
      "translation": "Is there a layover?"
    },
    {
      "speaker": "A",
      "text": "Kyll\u00e4, nelj\u00e4n tunnin v\u00e4lilasku Tukholmassa.",
      "translation": "Yes, a four-hour layover in Stockholm."
    },
    {
      "speaker": "B",
      "text": "Se on pitk\u00e4 v\u00e4lilasku.",
      "translation": "That is a long layover."
    },
    {
      "speaker": "A",
      "text": "Voimmeko k\u00e4ytt\u00e4\u00e4 odotusaulaa?",
      "translation": "Can we use the waiting hall?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, siell\u00e4 on my\u00f6s kahvila.",
      "translation": "Yes, there is also a caf\u00e9 there."
    },
    {
      "speaker": "A",
      "text": "Hienoa! Mit\u00e4 suosittelette?",
      "translation": "Great! What do you recommend?"
    },
    {
      "speaker": "B",
      "text": "Kokeile suomalaista kalakeittoa.",
      "translation": "Try the Finnish fish soup."
    },
    {
      "speaker": "A",
      "text": "Kuulostaa herkulliselta!",
      "translation": "Sounds delicious!"
    },
    {
      "speaker": "B",
      "text": "Hyv\u00e4\u00e4 matkaa!",
      "translation": "Have a good trip!"
    }
  ]
