    {
      "phrase": "\uc5ec\ub7ec\ubd84 \uac10\uc0ac\ud569\ub2c8\ub2e4.",
      "translation": "Thank you everyone.",
      "context": "Ending a meeting"
    },
    {
      "phrase": "\ub2e4\uc74c \ud3ec\uc778\ud2b8\ub97c \uc18c\uac1c\ud558\uaca0\uc2b5\ub2c8\ub2e4.",
      "translation": "I will present the next point.",
      "context": "Moving to next topic"
    },
    {
      "phrase": "\uc9c8\ubb38\uc774 \uc788\uc73c\uc138\uc694?",
      "translation": "Are there any questions?",
      "context": "Opening for questions"
    },
    {
      "phrase": "\ub098\uc911\uc5d0 \uc774 \ubb38\uc81c\ub85c \ub3cc\uc544\uac11\uc2dc\ub2e4.",
      "translation": "Let us return to this later.",
      "context": "Deferring discussion"
    },
    {
      "phrase": "\uc774\uac83\uc740 \ub354 \uc790\uc138\ud55c \uc870\uc0ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.",
      "translation": "This requires closer examination.",
      "context": "Requesting more analysis"
    },
    {
      "phrase": "\uc77c\uc815\ub300\ub85c \uc9c4\ud589\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
      "translation": "We are on schedule.",
      "context": "Status update"
    },
    {
      "phrase": "\uc791\uc5c5 \ud300\uc774 \uc774\uac83\uc744 \uacc4\uc18d\ud569\ub2c8\ub2e4.",
      "translation": "The working group will continue this.",
      "context": "Delegating task"
    },
    {
      "phrase": "\ub2e4\uc74c \ud68c\uc758\ub294 \ub2e4\uc74c \uc8fc\uc785\ub2c8\ub2e4.",
