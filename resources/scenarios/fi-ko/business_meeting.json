    },
    {
      "phrase": "\uc9c8\ubb38\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.",
      "translation": "The question is important.",
      "context": "Emphasizing importance"
    },
    {
      "phrase": "\uc9c0\uae08 \uacb0\uc815\ud560 \uc218 \uc788\uc744\uae4c\uc694?",
