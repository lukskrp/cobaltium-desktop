  "dialogues": [
    {
      "speaker": "A",
      "text": "\uc5ec\ub7ec\ubd84 \uc548\ub155\ud558\uc138\uc694. \uc2dc\uc791\ud560\uae4c\uc694?",
      "translation": "Good morning everyone. Shall we start?"
    },
    {
      "speaker": "B",
      "text": "\ub124, \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4.",
      "translation": "Yes, we are ready."
    },
    {
      "speaker": "A",
      "text": "\uc624\ub298 \uc6b0\ub9ac\ub294 \uc0c8\ub85c\uc6b4 \ud504\ub85c\uc81d\ud2b8\uc5d0 \ub300\ud574 \ub17c\uc758\ud569\ub2c8\ub2e4.",
      "translation": "Today we will discuss the new project."
    },
    {
      "speaker": "B",
      "text": "\ud504\ub85c\uc81d\ud2b8\uc758 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?",
      "translation": "What is the goal of the project?"
    },
    {
      "speaker": "A",
      "text": "\ubaa9\ud45c\ub294 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uac83\uc785\ub2c8\ub2e4.",
      "translation": "The goal is to improve customer satisfaction."
    },
    {
      "speaker": "B",
      "text": "\uc77c\uc815\uc740 \uc5b4\ub5a0\ud569\ub2c8\uae4c?",
      "translation": "What is the schedule?"
    },
    {
      "speaker": "A",
      "text": "3\uac1c\uc6d4 \uc548\uc5d0 \uc644\uc131\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.",
      "translation": "We want to have it ready in three months."
    },
    {
      "speaker": "B",
      "text": "\uadf8\uac83\uc740 \ube61\ube61\ud55c \uc77c\uc815\uc785\ub2c8\ub2e4.",
      "translation": "That is a tight schedule."
    },
    {
      "speaker": "A",
      "text": "\ub354 \ub9ce\uc740 \uc790\uc6d0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.",
      "translation": "We need more resources."
    },
    {
      "speaker": "B",
      "text": "\ub2e4\uc74c \ubd84\uae30 \uc608\uc0b0\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
      "translation": "We can use the budget from next quarter."
    },
    {
      "speaker": "A",
      "text": "\uc88b\uc740 \uc544\uc774\ub514\uc5b4\uc785\ub2c8\ub2e4. \ub204\uac00 \ud504\ub85c\uc81d\ud2b8\ub97c \ucc45\uc784\uc9d1\ub2c8\uae4c?",
      "translation": "Good idea. Who is responsible for the project?"
    },
    {
      "speaker": "B",
      "text": "\uc81c\uac00 \ucc45\uc784\uc744 \uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
      "translation": "I can take responsibility."
    },
    {
      "speaker": "A",
      "text": "\ud6cc\ub96d\ud569\ub2c8\ub2e4. \ub2e4\uc74c \ud68c\uc758\ub294 \ub2e4\uc74c \uc8fc\uc5d0 \ud569\uc2dc\ub2e4.",
      "translation": "Excellent. Let us hold the next meeting next week."
    },
    {
      "speaker": "B",
      "text": "\uc88b\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec\ubd84 \uac10\uc0ac\ud569\ub2c8\ub2e4.",
      "translation": "Agreed. Thank you everyone."
    },
    {
      "speaker": "A",
      "text": "\uc5ec\ub7ec\ubd84 \uc88b\uc740 \ud558\ub8e8 \ubcf4\ub0b4\uc138\uc694.",
      "translation": "Have a good day everyone."
    },
    {
      "speaker": "B",
      "text": "\uac10\uc0ac\ud569\ub2c8\ub2e4, \ub2f9\uc2e0\ub3c4.",
      "translation": "Thank you, you too."
    }
  ]
