  "dialogues": [
    {
      "speaker": "A",
      "text": "\u00a1Bienvenido al aeropuerto!",
      "translation": "Welcome to the airport!"
    },
    {
      "speaker": "B",
      "text": "Gracias. \u00bfD\u00f3nde est\u00e1 el mostrador?",
      "translation": "Thank you. Where is the counter?"
    },
    {
      "speaker": "A",
      "text": "El mostrador est\u00e1 all\u00e1 a la derecha.",
      "translation": "The counter is over there on the right."
    },
    {
      "speaker": "B",
      "text": "\u00bfA qu\u00e9 puerta debo ir?",
      "translation": "Which gate do I need to go to?"
    },
    {
      "speaker": "A",
      "text": "Puerta ocho, en el segundo piso.",
      "translation": "Gate eight, on the second floor."
    },
    {
      "speaker": "B",
      "text": "Gracias. \u00bfCu\u00e1ndo sale tu vuelo?",
      "translation": "Thank you. When does your flight leave?"
    },
    {
      "speaker": "A",
      "text": "El vuelo sale a las ocho.",
      "translation": "The flight leaves at eight o'clock."
    },
    {
      "speaker": "B",
      "text": "\u00bfHay escala?",
      "translation": "Is there a layover?"
    },
    {
      "speaker": "A",
      "text": "S\u00ed, una escala de cuatro horas en Estocolmo.",
      "translation": "Yes, a four-hour layover in Stockholm."
    },
    {
      "speaker": "B",
      "text": "Es una escala larga.",
      "translation": "That is a long layover."
    },
    {
      "speaker": "A",
      "text": "\u00bfPodemos usar la sala de espera?",
      "translation": "Can we use the waiting hall?"
    },
    {
      "speaker": "B",
      "text": "S\u00ed, all\u00e1 tambi\u00e9n hay caf\u00e9.",
      "translation": "Yes, there is also a caf\u00e9 there."
    },
    {
      "speaker": "A",
      "text": "\u00a1Genial! \u00bfQu\u00e9 recomiendan?",
      "translation": "Great! What do you recommend?"
    },
    {
      "speaker": "B",
      "text": "Prueba la sopa de pescado finlandesa.",
      "translation": "Try the Finnish fish soup."
    },
    {
      "speaker": "A",
      "text": "\u00a1Suena delicioso!",
      "translation": "Sounds delicious!"
    },
    {
      "speaker": "B",
      "text": "\u00a1Buen viaje!",
      "translation": "Have a good trip!"
    }
