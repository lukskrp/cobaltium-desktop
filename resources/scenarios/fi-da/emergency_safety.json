  "dialogues": [
    {
      "speaker": "A",
      "text": "H\u00e4t\u00e4! Soita 112!",
      "translation": "Emergency! Call 112!"
    },
    {
      "speaker": "B",
      "text": "Mit\u00e4 tapahtui?",
      "translation": "What happened?"
    },
    {
      "speaker": "A",
      "text": "Joku loukkaantui.",
      "translation": "Someone got injured."
    },
    {
      "speaker": "B",
      "text": "Soitan ambulanssin.",
      "translation": "I will call an ambulance."
    },
    {
      "speaker": "A",
      "text": "Kiitos! Onko h\u00e4nell\u00e4 ensiapua?",
      "translation": "Thank you! Does he have first aid?"
    },
    {
      "speaker": "B",
      "text": "Kyll\u00e4, min\u00e4 osaan ensiapua.",
      "translation": "Yes, I know first aid."
    },
    {
      "speaker": "A",
      "text": "Hienoa! Auta h\u00e4nt\u00e4.",
      "translation": "Great! Help him."
    },
    {
      "speaker": "B",
      "text": "Asetan h\u00e4net lep\u00e4\u00e4m\u00e4\u00e4n.",
      "translation": "I will lay him down to rest."
    },
    {
      "speaker": "A",
      "text": "Ambulanssi on tulossa.",
      "translation": "The ambulance is coming."
    },
    {
      "speaker": "B",
      "text": "Hyv\u00e4\u00e4. Pid\u00e4 h\u00e4nt\u00e4 silm\u00e4ll\u00e4.",
      "translation": "Good. Keep an eye on him."
    },
    {
      "speaker": "A",
      "text": "Onko paloa l\u00e4hell\u00e4?",
      "translation": "Is there a fire nearby?"
    },
    {
      "speaker": "B",
      "text": "Ei, mutta varo kuumaa astiaa.",
      "translation": "No, but watch out for the hot container."
    },
    {
      "speaker": "A",
      "text": "Kiitos varoituksesta.",
      "translation": "Thank you for the warning."
    },
    {
      "speaker": "B",
      "text": "Turvallisuus ensin.",
      "translation": "Safety first."
    },
    {
      "speaker": "A",
      "text": "Ambulanssi on saapunut.",
