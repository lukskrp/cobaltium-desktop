  "dialogues": [
    {
      "speaker": "A",
      "text": "Herkese iyi g\u00fcnler. Ba\u015flayal\u0131m m\u0131?",
      "translation": "Good morning everyone. Shall we start?"
    },
    {
      "speaker": "B",
      "text": "Evet, haz\u0131r\u0131z.",
      "translation": "Yes, we are ready."
    },
    {
      "speaker": "A",
      "text": "Bug\u00fcn yeni projeyi tart\u0131\u015faca\u011f\u0131z.",
      "translation": "Today we will discuss the new project."
    },
    {
      "speaker": "B",
      "text": "Projenin hedefi nedir?",
      "translation": "What is the goal of the project?"
    },
    {
      "speaker": "A",
      "text": "Hedef m\u00fc\u015fteri memnuniyetini art\u0131rmak.",
      "translation": "The goal is to improve customer satisfaction."
    },
    {
      "speaker": "B",
      "text": "Zamanlama nas\u0131l?",
      "translation": "What is the schedule?"
    },
    {
      "speaker": "A",
      "text": "\u00dc\u00e7 ayda bitirmek istiyoruz.",
      "translation": "We want to have it ready in three months."
    },
    {
      "speaker": "B",
      "text": "Bu s\u0131k\u0131 bir zamanlama.",
      "translation": "That is a tight schedule."
    },
    {
      "speaker": "A",
      "text": "Daha fazla kayna\u011fa ihtiyac\u0131m\u0131z var.",
      "translation": "We need more resources."
    },
    {
      "speaker": "B",
      "text": "Bir sonraki \u00e7eyre\u011fin b\u00fct\u00e7esini kullanabiliriz.",
      "translation": "We can use the budget from next quarter."
    },
    {
      "speaker": "A",
      "text": "\u0130yi fikir. Proje kimin sorumlulu\u011funda?",
      "translation": "Good idea. Who is responsible for the project?"
    },
    {
      "speaker": "B",
      "text": "Sorumlulu\u011fu \u00fcstlenebilirim.",
      "translation": "I can take responsibility."
    },
    {
      "speaker": "A",
      "text": "M\u00fckemmel. Bir sonraki toplant\u0131y\u0131 gelecek hafta yapal\u0131m.",
      "translation": "Excellent. Let us hold the next meeting next week."
    },
    {
      "speaker": "B",
      "text": "Tamam. Hepinize te\u015fekk\u00fcrler.",
      "translation": "Agreed. Thank you everyone."
    },
    {
      "speaker": "A",
      "text": "Herkese iyi g\u00fcnler.",
      "translation": "Have a good day everyone."
    },
    {
      "speaker": "B",
      "text": "Te\u015fekk\u00fcrler, size de.",
      "translation": "Thank you, you too."
    }
  ]
