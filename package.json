{
  "name": "cobaltium-desktop",
  "version": "1.0.0",
  "description": "Cobaltium for desktop — a cross-platform language-learning workspace.",
  "main": "./out/main/index.js",
  "author": "Cobaltium contributors",
  "packageManager": "pnpm@11.9.0",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/lukskrp/cobaltium-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukskrp/cobaltium-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:locales": "node scripts/gen-locales.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "build:espeak": "node scripts/build-espeak.mjs",
    "build:ja-bridge": "node scripts/build-ja-bridge.mjs",
    "build:tts": "node scripts/build-espeak.mjs && node scripts/build-ja-bridge.mjs",
    "build:whisper": "node scripts/build-whisper.mjs",
    "smoke:native": "node scripts/smoke-native.mjs",
    "build:native": "pnpm build:tts && pnpm build:whisper",
    "db:generate": "drizzle-kit generate",
    "pack:dir": "pnpm build:native && pnpm build && electron-builder --dir",
    "dist:win": "pnpm build:native && pnpm build && electron-builder --win",
    "dist:mac": "pnpm build:native && pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build:native && pnpm build && electron-builder --linux",
    "release:win": "pnpm build:native && pnpm build && electron-builder --win --publish always",
    "release:mac": "pnpm build:native && pnpm build && electron-builder --mac --publish always",
    "release:linux": "pnpm build:native && pnpm build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "koffi": "^3.2.1",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.12",
    "onnxruntime-node": "^1.29.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  }
}
